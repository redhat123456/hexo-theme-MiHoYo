<link rel="stylesheet" href="<%= url_for("css/post.css") %>">
<div class="posts">
  <a class="replay-btn" href="<%= url_for("index.html") %>">返回新闻列表</a>
  <div class="post-title">
    <p>
      <%= page.title %>
    </p>
    <hr>
    <time class="post-date" datetime="<%= page.date.toISOString() %>"><%= date(page.date, 'YYYY-MM-DD') %></time>
  </div>
  <div class="post-content">
    <%- page.content %>
  </div>
  <%- include('common/valine.ejs') %>
</div>