<link rel="stylesheet" href="<%= url_for("css/header.css") %>">
<div class="header">
  <div class="logo">
    <span class="pull-left">
      <a id="site-name" href="<%= url_for("/") %>">
        <%= theme.menuname %>
      </a>
    </span>
  </div>
  <ul class="nav-list">
    <% Object.keys(theme.topmenu).forEach(key=> { %>
      <li>
        <a href="<%=theme.topmenu[key]%>">
          <%=key%>
        </a>
      </li>
      <% }); %>
  </ul>
</div>